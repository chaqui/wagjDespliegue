[Unit]
Description=Vigilante continuo del despliegue Docker Swarm
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/ruta/al/proyecto/despliegue-inventario
Environment=POLL_INTERVAL=60
ExecStart=/ruta/al/proyecto/despliegue-inventario/watch_and_deploy.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=watch-deploy

[Install]
WantedBy=multi-user.target
