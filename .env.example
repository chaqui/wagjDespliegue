# Docker / Traefik
ACME_EMAIL=admin@grupowagj.duckdns.org
DOCKER_API_VERSION=1.45
# Generar con: echo $(htpasswd -nb admin 'CONTRASENA') | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$REEMPLAZAR$$HASH

# PostgreSQL compartido
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=grupowagj
DB_URL=jdbc:postgresql://postgres.example.internal:5432/grupowagj
DB_USERNAME=grupowagj_app
DB_PASSWORD=change_me

# Servicios compartidos
DB_SCHEMA=auth
DB_SCHEMA_AUTH=auth
DB_SCHEMA_CATALOGOS=catalogos
JWT_SECRET=change_me_with_a_long_random_secret

# Automatizacion del despliegue (opcionales)
HEALTH_TIMEOUT=180
PRUNE_OLD_IMAGES=false
PRUNE_UNTIL=168h
POLL_INTERVAL=300
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WEBHOOK_URL=

# Esquemas multiempresa documentados para aprovisionamiento y automatización.
# Los valores efectivos de DB_SCHEMA de los cuatro backends están fijados en
# docker-stack.yml para impedir que dos tenants compartan un esquema por error.
DB_SCHEMA_LOSMOLINOS_STORE=LosMolinosStore
DB_SCHEMA_CRECILANDIA_STORE=CrecilandiaStore
DB_SCHEMA_LOSMOLINOS_RESTAURANTE=LosMolinosRestaurante
DB_SCHEMA_CRECILANDIA_RESTAURANTE=CrecilandiaRestaurante

# Puertos internos por tenant
LOSMOLINOS_STORE_FRONTEND_PORT=3101
CRECILANDIA_STORE_FRONTEND_PORT=3102
LOSMOLINOS_RESTAURANTE_FRONTEND_PORT=3103
CRECILANDIA_RESTAURANTE_FRONTEND_PORT=3104
LOSMOLINOS_STORE_BACKEND_PORT=8101
CRECILANDIA_STORE_BACKEND_PORT=8102
LOSMOLINOS_RESTAURANTE_BACKEND_PORT=8103
CRECILANDIA_RESTAURANTE_BACKEND_PORT=8104
