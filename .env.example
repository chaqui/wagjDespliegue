### Ejemplo de archivo .env para docker-stack.yml
# Copia este archivo a `.env` y ajusta los valores antes de ejecutar:
#   cp .env.example .env
#   docker stack deploy -c docker-stack.yml sistema

# Host de la base de datos (servidor común para todos los servicios)
DB_HOST=tu-host-bd-externo

# Contraseña de la base de datos (si usas variables en lugar de secrets)
# Es más seguro usar `docker secret create db_password -` y el secreto en el stack.
DB_PASSWORD=mi_password_seguro

# Esquemas por servicio (puedes dejar los valores por defecto si lo prefieres)
DB_SCHEMA_AUTH=auth
DB_SCHEMA_CLINICA=public
DB_SCHEMA_CATALOGOS=catalogos

# MySQL password (si tu servicio catalogos usa MySQL y quieres pasar por env)
MYSQL_PASSWORD=mi_mysql_password

# Host público para las APIs usadas por los frontends
API_HOST=api.tu-clinica.com
